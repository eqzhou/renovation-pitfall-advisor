{
  "name": "xiaochengxu",
  "version": "0.1.0",
  "private": true,
  "description": "AI 垂直顾问小程序（装修避坑）— M1 脚手架",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "sass"
  },
  "scripts": {
    "dev:weapp": "HOME=\"$(pwd)/.taro-home\" USERPROFILE=\"$(pwd)/.taro-home\" taro build --type weapp --watch",
    "dev:h5": "HOME=\"$(pwd)/.taro-home\" USERPROFILE=\"$(pwd)/.taro-home\" taro build --type h5 --watch",
    "build:weapp": "HOME=\"$(pwd)/.taro-home\" USERPROFILE=\"$(pwd)/.taro-home\" taro build --type weapp",
    "build:h5": "HOME=\"$(pwd)/.taro-home\" USERPROFILE=\"$(pwd)/.taro-home\" taro build --type h5",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@babel/runtime": "^7.20.0",
    "@tarojs/components": "^4.2.0",
    "@tarojs/helper": "^4.2.0",
    "@tarojs/plugin-framework-react": "^4.2.0",
    "@tarojs/react": "^4.2.0",
    "@tarojs/runtime": "^4.2.0",
    "@tarojs/shared": "^4.2.0",
    "@tarojs/taro": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.5",
    "@tarojs/cli": "^4.2.0",
    "@tarojs/plugin-platform-weapp": "^4.2.1",
    "@tarojs/taro-loader": "^4.2.0",
    "@tarojs/webpack5-runner": "^4.2.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "ajv": "^8.20.0",
    "babel-preset-taro": "^4.2.0",
    "postcss": "^8.4.0",
    "react-refresh": "^0.11.0",
    "sass": "^1.49.0",
    "typescript": "^5.0.0",
    "vitest": "^2.1.0",
    "webpack": "^5.91.0"
  }
}
